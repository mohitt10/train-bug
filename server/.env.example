# Flask configuration
FLASK_SECRET_KEY=replace-with-a-generated-secret-key

# PostgreSQL connection
DATABASE_URL=postgresql://wanderlog_user:replace-with-password@localhost:5432/wanderlog_db

QUERY_HISTORY_LIMIT=500

# WARNING: Only set to 1 for local development testing of Phase 3 standalone.
# Must be 0 in production to prevent simulated dev user authentication.
ALLOW_DEV_AUTH=0
